{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arcscore-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  // Static site + demo app (Vite build) served from ./dist. Unknown paths fall
  // back to index.html so client routes like /app/athletes/:id work on reload.
  // The Worker runs first so it can mark non-production hosts noindex.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": { "enabled": true }
}
