{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arcscore-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  // Static site (Vite build) is served from ./dist; anything that isn't a file
  // falls back to index.html, and /api/* is handled by the Worker first.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
  // Uncomment after `wrangler d1 create arcscore` to persist demo / waitlist requests:
  // ,"d1_databases": [{ "binding": "DB", "database_name": "arcscore", "database_id": "<id>", "migrations_dir": "migrations" }]
}
